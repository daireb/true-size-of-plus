{
  "name": "worldscale",
  "version": "1.0.0",
  "description": "Drag countries around Earth to see past Mercator, or onto your own map at true size.",
  "license": "MIT",
  "author": "Daire Bohan",
  "homepage": "https://daireb.github.io/worldscale/",
  "repository": {
    "type": "git",
    "url": "https://github.com/daireb/worldscale.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "node --experimental-strip-types scripts/verify-geo.ts && node --experimental-strip-types scripts/verify-search.ts && node --experimental-strip-types scripts/verify-flat.ts",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-flat.mjs && node scripts/smoke-trace.mjs && node scripts/smoke-data.mjs && node scripts/smoke-mobile.mjs",
    "perf": "node scripts/perf.mjs",
    "data": "node scripts/build-data.mjs",
    "visual": "node scripts/visual.mjs",
    "perf:bystander": "node scripts/perf-bystander.mjs",
    "deploy": "sh scripts/deploy-pages.sh"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
